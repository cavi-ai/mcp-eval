{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cavi-ai/mcp-eval/main/docs/mcp-eval.probe-report.schema.json",
  "title": "mcpeval.probe-report/v2",
  "description": "Deterministic, share-safe probe report emitted by `mcpeval probe --format json` and `mcpeval score --format json`. `gate` counts the manifest cases; `readiness` is the score under an mcpeval readiness standard. Version 2 grows only by optional fields, so unknown properties are allowed. Retrieve with: mcpeval schema report",
  "type": "object",
  "required": [
    "schema",
    "server",
    "passed",
    "gate",
    "readiness",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "mcpeval.probe-report/v2"
    },
    "generator": {
      "type": "object",
      "description": "The mcpeval build that produced the report.",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "mcpeval"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "server": {
      "type": "string",
      "minLength": 1,
      "description": "The validated server label."
    },
    "manifest_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the manifest bytes the run parsed."
    },
    "passed": {
      "type": "boolean",
      "description": "Every manifest case passed; true when no manifest ran."
    },
    "readiness": {
      "oneOf": [
        {
          "$ref": "#/$defs/readiness"
        },
        {
          "type": "null"
        }
      ],
      "description": "Readiness under an mcpeval standard; null under --gate-only, for a selected probe, or when the standard battery could not finish."
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "gate": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "passed",
            "total"
          ],
          "additionalProperties": false,
          "properties": {
            "passed": {
              "$ref": "#/$defs/count"
            },
            "total": {
              "$ref": "#/$defs/count"
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "Manifest cases passed and declared; null when no manifest ran."
    },
    "readiness_error": {
      "oneOf": [
        {
          "$ref": "#/$defs/reason"
        },
        {
          "type": "null"
        }
      ],
      "description": "Why the standard battery could not finish."
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "enum": [
        "unexpected-outcome",
        "missing-field",
        "value-mismatch",
        "error-code-mismatch",
        "discovery-limit-exceeded",
        "token-budget-exceeded",
        "invalid-schema",
        "missing-required-argument",
        "expected-error",
        "unstable-error-code",
        "retryability-mismatch",
        "retry-did-not-recover",
        "failure-not-observed",
        "recovery-failed",
        "validation-failed",
        "contended-client-failed",
        "latency-budget-exceeded",
        "pagination-invalid-entry",
        "pagination-duplicate-tool",
        "pagination-stalled-cursor",
        "payload-unhandled",
        "surface-invalid-envelope",
        "surface-stalled-cursor",
        "output-schema-declared-but-missing",
        "output-schema-field-missing",
        "output-schema-invalid-result",
        "cancellation-ignored",
        "cancellation-errored",
        "negotiation-echoed-unknown",
        "negotiation-invalid-version",
        "negotiation-inconsistent-support",
        "sampling-invalid-request",
        "sampling-request-flood",
        "sampling-stalled-call",
        "elicitation-invalid-request",
        "elicitation-request-flood",
        "elicitation-stalled-call",
        "resource-unreadable",
        "subscription-rejected",
        "subscription-notification-missing",
        "completion-invalid-request",
        "completion-value-flood",
        "completion-argument-unknown",
        "completion-stalled-request",
        "transport-timeout",
        "transport-closed",
        "transport-error",
        "evaluation-budget-exceeded"
      ],
      "description": "Fixed failure label; transport-* and evaluation-budget-exceeded mean the case could not finish. `mcpeval explain <reason>` prints the fix."
    },
    "readiness": {
      "type": "object",
      "required": [
        "standard",
        "score",
        "badge",
        "attested_read_only",
        "surface",
        "areas"
      ],
      "properties": {
        "standard": {
          "type": "string",
          "pattern": "^mcpeval-standard/[0-9]+(-draft)?$"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "badge": {
          "type": "string",
          "format": "uri"
        },
        "attested_read_only": {
          "type": "boolean"
        },
        "surface": {
          "type": "object",
          "required": [
            "tools",
            "read_only",
            "writers",
            "exercised"
          ],
          "properties": {
            "tools": {
              "$ref": "#/$defs/count"
            },
            "read_only": {
              "$ref": "#/$defs/count"
            },
            "writers": {
              "$ref": "#/$defs/count"
            },
            "exercised": {
              "$ref": "#/$defs/count"
            }
          }
        },
        "areas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/area"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "probe",
        "passed",
        "attempts",
        "first_failure",
        "reason",
        "measurements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$"
        },
        "probe": {
          "enum": [
            "contention",
            "error-honesty",
            "state-recovery",
            "discovery-cost",
            "token-cost",
            "schema-guessability",
            "degradation-over-n",
            "instruction-fidelity",
            "latency-budget",
            "pagination",
            "payload-bounds",
            "surface-listing",
            "output-schema",
            "cancellation",
            "protocol-negotiation",
            "sampling",
            "elicitation",
            "resource-subscription",
            "completion"
          ]
        },
        "tool": {
          "type": [
            "string",
            "null"
          ],
          "description": "The tool the case calls, when it calls one."
        },
        "passed": {
          "type": "boolean"
        },
        "attempts": {
          "$ref": "#/$defs/count"
        },
        "first_failure": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "hint": {
          "type": [
            "string",
            "null"
          ],
          "description": "The server-side remediation for the reason."
        },
        "detail": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "bound",
                "limit",
                "observed"
              ],
              "additionalProperties": false,
              "properties": {
                "bound": {
                  "enum": [
                    "max_tools",
                    "max_schema_bytes",
                    "max_total_tokens",
                    "max_tool_tokens",
                    "max_latency_ms",
                    "max_pages"
                  ]
                },
                "limit": {
                  "$ref": "#/$defs/count"
                },
                "observed": {
                  "$ref": "#/$defs/count"
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "The manifest bound a bound-based failure exceeded, beside the observed value."
        },
        "measurements": {
          "type": "object",
          "properties": {
            "tool_count": {
              "$ref": "#/$defs/count"
            },
            "schema_bytes": {
              "$ref": "#/$defs/count"
            },
            "total_tokens": {
              "$ref": "#/$defs/count"
            },
            "per_tool": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "tool",
                  "tokens"
                ],
                "properties": {
                  "tool": {
                    "type": "string"
                  },
                  "tokens": {
                    "$ref": "#/$defs/count"
                  }
                }
              }
            },
            "latency_ms": {
              "$ref": "#/$defs/count"
            },
            "pages": {
              "$ref": "#/$defs/count"
            }
          }
        }
      }
    },
    "area": {
      "type": "object",
      "required": [
        "name",
        "weight",
        "score",
        "measurements",
        "checks"
      ],
      "properties": {
        "name": {
          "enum": [
            "protocol",
            "catalog",
            "context",
            "error-honesty",
            "reliability",
            "coverage"
          ]
        },
        "weight": {
          "$ref": "#/$defs/count"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "measurements": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/count"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "tool",
        "score",
        "observed",
        "reason",
        "hint"
      ],
      "properties": {
        "id": {
          "enum": [
            "context.catalog",
            "context.heaviest-tool",
            "reliability.success",
            "reliability.consistent",
            "reliability.latency",
            "reliability.output-schema",
            "reliability.contention",
            "reliability.payload",
            "reliability.none-exercised",
            "reliability.skipped",
            "coverage.exercised",
            "catalog.description",
            "catalog.params-described",
            "catalog.params-typed",
            "catalog.read-only-declared",
            "catalog.destructive-declared",
            "catalog.output-schema",
            "catalog.empty",
            "protocol.negotiation",
            "protocol.unknown-method",
            "protocol.ping",
            "protocol.unknown-tool",
            "protocol.pagination",
            "protocol.surfaces",
            "error-honesty.invalid-arguments",
            "error-honesty.untestable"
          ]
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "observed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reason": {
          "enum": [
            "context-catalog-heavy",
            "context-tool-heavy",
            "reliability-call-failed",
            "reliability-inconsistent",
            "reliability-slow",
            "reliability-output-schema-broken",
            "reliability-contention-failed",
            "reliability-payload-unhandled",
            "reliability-none-exercised",
            "coverage-unannotated",
            "coverage-unsynthesizable",
            "coverage-skipped",
            "coverage-rejected-arguments",
            "coverage-call-failed",
            "no-read-only-tools",
            "catalog-short-description",
            "catalog-undescribed-params",
            "catalog-untyped-params",
            "catalog-read-only-undeclared",
            "catalog-destructive-undeclared",
            "catalog-no-output-schema",
            "catalog-no-tools",
            "protocol-negotiation-echoed-unknown",
            "protocol-negotiation-invalid-version",
            "protocol-negotiation-inconsistent-support",
            "protocol-unknown-method-answered",
            "protocol-ping-failed",
            "protocol-unknown-tool-accepted",
            "protocol-pagination-invalid",
            "protocol-surface-invalid",
            "protocol-call-failed",
            "honesty-accepted-invalid",
            "honesty-empty-error",
            "honesty-wrong-code",
            "honesty-call-failed",
            "honesty-untestable"
          ]
        },
        "hint": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
