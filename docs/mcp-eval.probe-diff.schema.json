{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cavi-ai/mcp-eval/main/docs/mcp-eval.probe-diff.schema.json",
  "title": "mcpeval.probe-diff/v2",
  "description": "Deterministic diff of two mcpeval.probe-report documents (v1 or v2) of one server, emitted by `mcpeval diff --format json`. Readiness moves only when both sides were scored under the same standard and known measurement profile. Version 2 grows only by optional fields, so unknown properties are allowed. Retrieve with: mcpeval schema diff",
  "type": "object",
  "required": [
    "schema",
    "readiness",
    "summary",
    "cases",
    "removed",
    "added"
  ],
  "properties": {
    "schema": {
      "const": "mcpeval.probe-diff/v2"
    },
    "readiness": {
      "type": "object",
      "required": [
        "baseline",
        "current",
        "baseline_standard",
        "current_standard",
        "comparable"
      ],
      "properties": {
        "baseline": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "current": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline_standard": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_standard": {
          "type": [
            "string",
            "null"
          ]
        },
        "comparable": {
          "type": "boolean"
        },
        "baseline_profile": {
          "oneOf": [
            {
              "$ref": "#/$defs/measurement_profile"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_profile": {
          "oneOf": [
            {
              "$ref": "#/$defs/measurement_profile"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "regressed",
        "fixed",
        "changed",
        "unchanged",
        "removed",
        "added"
      ],
      "properties": {
        "regressed": {
          "$ref": "#/$defs/count"
        },
        "fixed": {
          "$ref": "#/$defs/count"
        },
        "changed": {
          "$ref": "#/$defs/count"
        },
        "unchanged": {
          "$ref": "#/$defs/count"
        },
        "removed": {
          "$ref": "#/$defs/count"
        },
        "added": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Case ids present only in the baseline."
    },
    "added": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Case ids present only in the current report."
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "oneOf": [
        {
          "enum": [
            "unexpected-outcome",
            "missing-field",
            "value-mismatch",
            "error-code-mismatch",
            "discovery-limit-exceeded",
            "token-budget-exceeded",
            "invalid-schema",
            "missing-required-argument",
            "expected-error",
            "unstable-error-code",
            "retryability-mismatch",
            "retry-did-not-recover",
            "failure-not-observed",
            "recovery-failed",
            "validation-failed",
            "contended-client-failed",
            "latency-budget-exceeded",
            "pagination-invalid-entry",
            "pagination-duplicate-tool",
            "pagination-stalled-cursor",
            "payload-unhandled",
            "surface-invalid-envelope",
            "surface-stalled-cursor",
            "output-schema-declared-but-missing",
            "output-schema-field-missing",
            "output-schema-invalid-result",
            "cancellation-ignored",
            "cancellation-errored",
            "negotiation-echoed-unknown",
            "negotiation-invalid-version",
            "negotiation-inconsistent-support",
            "sampling-invalid-request",
            "sampling-request-flood",
            "sampling-stalled-call",
            "elicitation-invalid-request",
            "elicitation-request-flood",
            "elicitation-stalled-call",
            "resource-unreadable",
            "subscription-rejected",
            "subscription-notification-missing",
            "completion-invalid-request",
            "completion-value-flood",
            "completion-argument-unknown",
            "completion-stalled-request",
            "transport-timeout",
            "transport-closed",
            "transport-error",
            "evaluation-budget-exceeded"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "pair": {
      "type": "object",
      "required": [
        "baseline",
        "current"
      ],
      "properties": {
        "baseline": {
          "type": "integer",
          "minimum": 0
        },
        "current": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "probe",
        "verdict",
        "baseline_reason",
        "current_reason",
        "measurements"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "probe": {
          "enum": [
            "contention",
            "error-honesty",
            "state-recovery",
            "discovery-cost",
            "token-cost",
            "schema-guessability",
            "degradation-over-n",
            "instruction-fidelity",
            "latency-budget",
            "pagination",
            "payload-bounds",
            "surface-listing",
            "output-schema",
            "cancellation",
            "protocol-negotiation",
            "sampling",
            "elicitation",
            "resource-subscription",
            "completion",
            "workflow"
          ]
        },
        "verdict": {
          "enum": [
            "regressed",
            "fixed",
            "changed",
            "unchanged"
          ]
        },
        "baseline_reason": {
          "$ref": "#/$defs/reason"
        },
        "current_reason": {
          "$ref": "#/$defs/reason"
        },
        "measurements": {
          "type": "object",
          "properties": {
            "total_tokens": {
              "$ref": "#/$defs/pair"
            },
            "latency_ms": {
              "$ref": "#/$defs/pair"
            }
          }
        }
      }
    },
    "measurement_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "evaluator_version",
        "platform",
        "architecture",
        "client_capabilities",
        "attested_read_only",
        "skip_tools",
        "call_timeout_ms",
        "repeats"
      ],
      "properties": {
        "schema": {
          "const": "mcpeval.measurement-profile/v1"
        },
        "evaluator_version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "platform": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$"
        },
        "architecture": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$"
        },
        "client_capabilities": {
          "const": "none"
        },
        "attested_read_only": {
          "type": "boolean"
        },
        "skip_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          }
        },
        "call_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "repeats": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
