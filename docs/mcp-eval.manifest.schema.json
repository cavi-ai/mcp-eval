{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cavi-ai/mcp-eval/main/docs/mcp-eval.manifest.schema.json",
  "title": "mcp-eval manifest",
  "description": "Strict, versioned declaration of deterministic probes and sandboxes for mcpeval. Unknown fields are rejected before the server process starts. Retrieve with: mcpeval schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "probes"],
  "properties": {
    "version": { "const": 1 },
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 600000,
      "description": "Per-request response timeout in milliseconds. Unset, stdio waits 30 s and HTTP 5 s. A latency-budget call waits max_latency_ms plus this timeout. A request past it marks the case transport-timeout."
    },
    "sandboxes": {
      "type": "object",
      "description": "Named disposable environments referenced by mutating probes.",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description"],
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 240,
            "description": "What the sandbox is allowed to touch. Never persisted."
          }
        }
      }
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/probeCase" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$"
    },
    "toolName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_:.\\-]{1,128}$"
    },
    "access": {
      "enum": ["read_only", "mutating"]
    },
    "arguments": {
      "type": "object",
      "description": "Arguments passed to tools/call. Never persisted or printed."
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["ok", "error"] },
        "required_result_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "equals": {
          "type": "object",
          "description": "Scalar result fields that must equal these values; string values must be identifier-shaped.",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": {
            "type": ["null", "boolean", "number", "string"]
          }
        },
        "error_code": {
          "type": "integer",
          "description": "Only valid when outcome is error."
        }
      }
    },
    "probeCase": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "probe", "tool", "access", "arguments"],
          "properties": {
            "probe": { "const": "contention" },
            "id": { "$ref": "#/$defs/identifier" },
            "tool": { "$ref": "#/$defs/toolName" },
            "access": { "$ref": "#/$defs/access" },
            "sandbox": { "$ref": "#/$defs/identifier" },
            "arguments": { "$ref": "#/$defs/arguments" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "probe", "tool", "access", "arguments",
            "max_attempts", "expect_retryable"
          ],
          "properties": {
            "probe": { "const": "error-honesty" },
            "id": { "$ref": "#/$defs/identifier" },
            "tool": { "$ref": "#/$defs/toolName" },
            "access": { "$ref": "#/$defs/access" },
            "sandbox": { "$ref": "#/$defs/identifier" },
            "arguments": { "$ref": "#/$defs/arguments" },
            "max_attempts": { "type": "integer", "minimum": 2, "maximum": 20 },
            "expect_retryable": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "probe", "access",
            "failure_tool", "failure_arguments",
            "recovery_tool", "recovery_arguments",
            "validation_tool", "validation_arguments"
          ],
          "properties": {
            "probe": { "const": "state-recovery" },
            "id": { "$ref": "#/$defs/identifier" },
            "failure_tool": { "$ref": "#/$defs/toolName" },
            "failure_arguments": { "$ref": "#/$defs/arguments" },
            "recovery_tool": { "$ref": "#/$defs/toolName" },
            "recovery_arguments": { "$ref": "#/$defs/arguments" },
            "validation_tool": { "$ref": "#/$defs/toolName" },
            "validation_arguments": { "$ref": "#/$defs/arguments" },
            "access": { "$ref": "#/$defs/access" },
            "sandbox": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "probe", "access", "max_tools", "max_schema_bytes"],
          "properties": {
            "probe": { "const": "discovery-cost" },
            "id": { "$ref": "#/$defs/identifier" },
            "access": { "const": "read_only" },
            "max_tools": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "max_schema_bytes": { "type": "integer", "minimum": 1, "maximum": 10000000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "probe", "access", "max_total_tokens"],
          "properties": {
            "probe": { "const": "token-cost" },
            "id": { "$ref": "#/$defs/identifier" },
            "access": { "const": "read_only" },
            "max_total_tokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "max_tool_tokens": { "type": "integer", "minimum": 1, "maximum": 100000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "probe", "tool", "access", "arguments"],
          "properties": {
            "probe": { "const": "schema-guessability" },
            "id": { "$ref": "#/$defs/identifier" },
            "tool": { "$ref": "#/$defs/toolName" },
            "access": { "$ref": "#/$defs/access" },
            "sandbox": { "$ref": "#/$defs/identifier" },
            "arguments": { "$ref": "#/$defs/arguments" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "probe", "tool", "access", "arguments", "max_attempts"],
          "properties": {
            "probe": { "const": "degradation-over-n" },
            "id": { "$ref": "#/$defs/identifier" },
            "tool": { "$ref": "#/$defs/toolName" },
            "access": { "$ref": "#/$defs/access" },
            "sandbox": { "$ref": "#/$defs/identifier" },
            "arguments": { "$ref": "#/$defs/arguments" },
            "max_attempts": { "type": "integer", "minimum": 2, "maximum": 100 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "probe", "tool", "access", "arguments", "expect"],
          "properties": {
            "probe": { "const": "instruction-fidelity" },
            "id": { "$ref": "#/$defs/identifier" },
            "tool": { "$ref": "#/$defs/toolName" },
            "access": { "$ref": "#/$defs/access" },
            "sandbox": { "$ref": "#/$defs/identifier" },
            "arguments": { "$ref": "#/$defs/arguments" },
            "expect": { "$ref": "#/$defs/expectation" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "probe", "tool", "access", "arguments",
            "attempts", "max_latency_ms"
          ],
          "properties": {
            "probe": { "const": "latency-budget" },
            "id": { "$ref": "#/$defs/identifier" },
            "tool": { "$ref": "#/$defs/toolName" },
            "access": { "const": "read_only" },
            "sandbox": { "$ref": "#/$defs/identifier" },
            "arguments": { "$ref": "#/$defs/arguments" },
            "attempts": { "type": "integer", "minimum": 2, "maximum": 20 },
            "max_latency_ms": { "type": "integer", "minimum": 1, "maximum": 600000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "probe", "access", "max_pages"],
          "properties": {
            "probe": { "const": "pagination" },
            "id": { "$ref": "#/$defs/identifier" },
            "access": { "const": "read_only" },
            "max_pages": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "probe", "tool", "access", "arguments",
            "field", "size_bytes", "expect_handled"
          ],
          "properties": {
            "probe": { "const": "payload-bounds" },
            "id": { "$ref": "#/$defs/identifier" },
            "tool": { "$ref": "#/$defs/toolName" },
            "access": { "const": "read_only" },
            "sandbox": { "$ref": "#/$defs/identifier" },
            "arguments": { "$ref": "#/$defs/arguments" },
            "field": { "$ref": "#/$defs/identifier" },
            "size_bytes": { "type": "integer", "minimum": 1, "maximum": 16000000 },
            "expect_handled": {
              "type": "boolean",
              "description": "When true, a clean rejection at this size fails the case: the tool must actually handle it."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "probe", "access", "max_pages"],
          "properties": {
            "probe": { "const": "surface-listing" },
            "id": { "$ref": "#/$defs/identifier" },
            "access": { "const": "read_only" },
            "max_pages": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "probe", "tool", "access", "arguments"],
          "properties": {
            "probe": { "const": "output-schema" },
            "id": { "$ref": "#/$defs/identifier" },
            "tool": { "$ref": "#/$defs/toolName" },
            "access": { "const": "read_only" },
            "sandbox": { "$ref": "#/$defs/identifier" },
            "arguments": { "$ref": "#/$defs/arguments" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "probe", "tool", "access", "arguments",
            "grace_seconds", "reason"
          ],
          "properties": {
            "probe": { "const": "cancellation" },
            "id": { "$ref": "#/$defs/identifier" },
            "tool": { "$ref": "#/$defs/toolName" },
            "access": { "const": "read_only" },
            "sandbox": { "$ref": "#/$defs/identifier" },
            "arguments": { "$ref": "#/$defs/arguments" },
            "grace_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "description": "How long the probe waits post-cancel for a response the server must never send."
            },
            "reason": {
              "$ref": "#/$defs/identifier",
              "description": "Free-form identifier recorded in the cancellation notification."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "probe", "access", "bogus_version"],
          "properties": {
            "probe": { "const": "protocol-negotiation" },
            "id": { "$ref": "#/$defs/identifier" },
            "access": { "const": "read_only" },
            "bogus_version": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "description": "Unknown date-shaped protocol version the probe offers; the server must answer with its own supported version instead of echoing this one."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "probe", "tool", "access", "arguments", "max_requests"],
          "properties": {
            "probe": { "const": "sampling" },
            "id": { "$ref": "#/$defs/identifier" },
            "tool": { "$ref": "#/$defs/toolName" },
            "access": { "const": "read_only" },
            "sandbox": { "$ref": "#/$defs/identifier" },
            "arguments": { "$ref": "#/$defs/arguments" },
            "max_requests": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "description": "Upper bound on sampling/createMessage requests the server may issue during this one tool call."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "probe", "tool", "access", "arguments", "max_requests", "respond"
          ],
          "properties": {
            "probe": { "const": "elicitation" },
            "id": { "$ref": "#/$defs/identifier" },
            "tool": { "$ref": "#/$defs/toolName" },
            "access": { "const": "read_only" },
            "sandbox": { "$ref": "#/$defs/identifier" },
            "arguments": { "$ref": "#/$defs/arguments" },
            "max_requests": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "description": "Upper bound on elicitation/create requests the server may issue during this one tool call."
            },
            "respond": {
              "enum": ["accept", "decline", "cancel"],
              "description": "How the probe answers each elicitation request."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "probe", "access", "uri", "max_wait_seconds"],
          "properties": {
            "probe": { "const": "resource-subscription" },
            "id": { "$ref": "#/$defs/identifier" },
            "access": { "const": "read_only" },
            "uri": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "Resource URI to subscribe to; the server must declare resources.subscribe."
            },
            "trigger_tool": {
              "$ref": "#/$defs/toolName",
              "description": "Tool whose call must trigger the update notification."
            },
            "trigger_arguments": { "$ref": "#/$defs/arguments" },
            "max_wait_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "description": "How long the probe waits for notifications/resources/updated."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "probe",
            "access",
            "ref_type",
            "ref_uri",
            "argument_name",
            "argument_value",
            "max_values"
          ],
          "properties": {
            "probe": { "const": "completion" },
            "id": { "$ref": "#/$defs/identifier" },
            "access": { "const": "read_only" },
            "ref_type": {
              "enum": ["ref/prompt", "ref/resource"],
              "description": "The reference type the completion is requested for."
            },
            "ref_uri": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "Prompt name (ref/prompt) or resource URI (ref/resource) the completion is requested for."
            },
            "argument_name": {
              "$ref": "#/$defs/identifier",
              "description": "The argument whose completion is requested; the prompt must declare it."
            },
            "argument_value": {
              "$ref": "#/$defs/identifier",
              "description": "Prefix text the probe offers; identifier-shaped."
            },
            "max_values": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Upper bound on completion values the probe accepts per request."
            }
          }
        }
      ]
    }
  }
}
