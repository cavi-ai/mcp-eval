{
  "name": "@cavi-ai/mcp-eval",
  "version": "0.1.0",
  "description": "Checksummed native distribution of the MCP Eval CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cavi-ai/mcp-eval.git"
  },
  "homepage": "https://github.com/cavi-ai/mcp-eval",
  "bugs": "https://github.com/cavi-ai/mcp-eval/issues",
  "type": "module",
  "bin": {
    "mcpeval": "npm/run.mjs"
  },
  "files": [
    "distribution/release.json",
    "npm/install.mjs",
    "npm/run.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node npm/install.mjs",
    "test:distribution": "node --test scripts/distribution/*.test.mjs",
    "verify:distribution": "node scripts/distribution/verify.mjs",
    "verify:package": "node scripts/distribution/package-e2e.mjs",
    "prepack": "node scripts/distribution/verify.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "evaluation",
    "observability",
    "privacy"
  ]
}
