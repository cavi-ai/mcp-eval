# Repository CI-equivalent deterministic lanes.
cargo fmt --all --check
cargo clippy --all-targets --locked -- -D warnings
cargo test --all-targets --locked -- --test-threads=1
python3 scripts/check-version-agreement.py
npm run docs:build
npm run docs:verify
npm run docs:test
MCPEVAL_TEST_BIN_DIR=target/debug npm run test:action
MCPEVAL_CORPUS_TEST_BINARY=target/debug/mcpeval npm run test:corpus
npm run test:distribution
npm run verify:distribution
git diff --check
